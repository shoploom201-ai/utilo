---
// AdSense 광고 한 자리. src/site.ts 의 adsense 설정이 비어 있으면 아무것도 그리지 않습니다.
// 도구 버튼과 떨어진 곳(도구 아래, 글 중간, 목록 위)에만 두어 실수 클릭을 막습니다.
import { SITE } from '../site';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
  // 주의: 이름을 "slot"으로 하면 Astro 예약어와 겹쳐 레이아웃 안에서 광고가 사라집니다.
  position: keyof typeof SITE.adsense.slots;
}
const { lang, position } = Astro.props;
const client = SITE.adsense.client;
const slotId = SITE.adsense.slots[position];
// 구글이 허용하는 광고 표시 문구
const LABEL: Record<Locale, string> = { ko: '광고', ja: '広告', es: 'Publicidad', en: 'Advertisement' };
---

{
  client && slotId && (
    <aside class="ad-slot" aria-label={LABEL[lang]}>
      <span class="ad-label">{LABEL[lang]}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}
