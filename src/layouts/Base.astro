---
import '../styles/global.css';
import { locales, defaultLocale, t, type Locale } from '../i18n';
import { ogLocale } from '../i18n/seo';
import { SITE } from '../site';

interface Props {
  lang: Locale;
  /** 검색 결과에 보일 제목 (사이트 이름은 자동으로 붙음) */
  title: string;
  description: string;
  /** 각 언어별 이 페이지의 주소. 예: { ko: "/ko/부가세-계산기/", en: "/en/vat-calculator/", ... } */
  paths: Partial<Record<Locale, string>>;
  /** 구조화 데이터(JSON-LD). 검색엔진이 페이지 종류를 이해하도록 돕습니다. */
  jsonLd?: object[];
  isHome?: boolean;
  /** x-default 를 다른 주소로 (각 언어 홈은 루트 언어 선택 페이지 "/" 를 가리켜야 서로 일치함) */
  xDefaultPath?: string;
}

const { lang, title, description, paths, jsonLd = [], isHome = false, xDefaultPath } = Astro.props;
const d = t(lang);
const site = Astro.site ?? new URL('https://example.com');
// 이 페이지가 있는 언어만 (예: 일본어 화면에는 "일본어 라디오" 페이지가 없음)
const available = locales.filter((l) => paths[l]);
const urlFor = (l: Locale) => new URL(paths[l] ?? `/${l}/`, site).href;
const xDefault = paths[defaultLocale] ? defaultLocale : lang;
const fullTitle = isHome ? `${SITE.name} — ${title}` : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlFor(lang)} />
    {available.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultPath ? new URL(xDefaultPath, site).href : urlFor(xDefault)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {available.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {
      /* AdSense: src/site.ts 에 게시자 ID를 넣으면 자동으로 들어갑니다 (자동 광고·앵커 광고도 이 한 줄로 동작) */
      SITE.adsense.client && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`/${lang}/`}>{SITE.name}</a>
        <details class="lang-menu">
          <summary aria-label={d.nav.language}>{d.langName}</summary>
          <ul>
            {
              locales.map((l) => (
                <li>
                  <a href={paths[l] ?? `/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                    {t(l).langName}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <nav>
          <a href={`/${lang}/about/`}>{d.footer.about}</a>
          <a href={`/${lang}/privacy/`}>{d.footer.privacy}</a>
          <a href={`/${lang}/contact/`}>{d.footer.contact}</a>
        </nav>
        <p>© {new Date().getFullYear()} {SITE.name}. {d.footer.note}</p>
      </div>
    </footer>
  </body>
</html>
