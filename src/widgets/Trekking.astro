---
// 나라별 트래킹 추천. 데이터는 src/data/treks.ts. 모든 나라를 페이지에 그려 두고(검색엔진 색인용) 드롭다운으로 하나만 보여 줌.
import ToolInfo from '../components/ToolInfo.astro';
import { t, type Locale } from '../i18n';
import { TREKS, TREKS_REVIEWED, DEFAULT_COUNTRY } from '../data/treks';

const { lang } = Astro.props as { lang: Locale };
const d = t(lang);
const tool = d.tools['trekking']!;
const ui = tool.ui;
const regionNames = new Intl.DisplayNames([lang], { type: 'region' });
const monthName = new Intl.DateTimeFormat(lang, { month: 'short' });
const month = (m: number) => monthName.format(new Date(2026, m - 1, 15));
const num = new Intl.NumberFormat(lang);
const flag = (code: string) => String.fromCodePoint(...[...code].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65));
const countries = Object.keys(TREKS)
  .map((code) => ({ code, name: regionNames.of(code) ?? code }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));
const def = DEFAULT_COUNTRY[lang] in TREKS ? DEFAULT_COUNTRY[lang] : countries[0].code;
const duration = (dd: [number, number]) =>
  dd[1] === 1 ? ui.dayHike : (dd[0] === dd[1] ? ui.days.replace('{n}', String(dd[0])) : ui.days.replace('{n}', `${dd[0]}–${dd[1]}`));
const levelLabel = (l: 1 | 2 | 3) => [ui.level1, ui.level2, ui.level3][l - 1];
---

<h1>{tool.name}</h1>
<p class="lead">{tool.short}</p>

<section class="card trek" id="trek">
  <label>{ui.country}
    <select id="trek-country">
      {countries.map((c) => <option value={c.code} selected={c.code === def}>{flag(c.code)} {c.name} ({TREKS[c.code].length})</option>)}
    </select>
  </label>

  {
    countries.map((c) => (
      <section class="trek-country" data-country={c.code} hidden={c.code !== def}>
        <h2>{flag(c.code)} {ui.topIn.replace('{country}', c.name).replace('{n}', String(TREKS[c.code].length))}</h2>
        <ol class="treks">
          {TREKS[c.code].map((tr) => (
            <li class="tk">
              <h3>{tr.name}</h3>
              <p class="area">📍 {tr.area}</p>
              <div class="stats">
                <span>📏 {ui.distance} <strong>{num.format(tr.km)} km</strong></span>
                <span>⏱ {ui.duration} <strong>{duration(tr.days)}</strong></span>
                <span class={`lv lv${tr.level}`}>{levelLabel(tr.level)}</span>
              </div>
              <p class="months">🗓 {ui.best}: {tr.months.map((m) => <span class="m">{month(m)}</span>)}</p>
              <p class="tags">
                {tr.features.map((f) => <span class="tag">{ui.features[f]}</span>)}
                {tr.needs.map((n) => <span class="tag need">{ui.needs[n]}</span>)}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
  <p class="note">{ui.disclaimer.replace('{date}', TREKS_REVIEWED)}</p>
</section>

<ToolInfo lang={lang} howTo={tool.howTo} faq={tool.faq} />

<style>
  .trek { display: grid; gap: 1rem; }
  .trek-country h2 { font-size: 1.15rem; margin: .4rem 0 .8rem; }
  .treks { display: grid; gap: .8rem; padding-left: 1.3rem; margin: 0; }
  .tk { border: 1px solid var(--border, #ddd); border-radius: 12px; padding: .8rem 1rem; display: grid; gap: .35rem; }
  .tk h3 { margin: 0; font-size: 1.05rem; }
  .area { margin: 0; color: var(--muted); font-size: .92rem; }
  .stats { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; align-items: center; font-size: .93rem; }
  .lv { font-size: .8rem; padding: .12rem .6rem; border-radius: 999px; font-weight: 600; }
  .lv1 { background: color-mix(in srgb, #1baf7a 20%, transparent); }
  .lv2 { background: color-mix(in srgb, #eda100 25%, transparent); }
  .lv3 { background: color-mix(in srgb, #d93025 20%, transparent); }
  .months, .tags { margin: 0; display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; font-size: .9rem; }
  .m { padding: .05rem .4rem; border-radius: 6px; background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .tag { font-size: .78rem; padding: .1rem .5rem; border-radius: 999px; border: 1px solid var(--border, #ccc); }
  .tag.need { border-style: dashed; }
</style>

<script>
  const root = document.getElementById('trek') as HTMLElement;
  const sel = root.querySelector('#trek-country') as HTMLSelectElement;
  const KEY = 'kitwise-trek-country';
  const show = () => root.querySelectorAll<HTMLElement>('.trek-country').forEach((s) => (s.hidden = s.dataset.country !== sel.value));
  try {
    const saved = localStorage.getItem(KEY);
    if (saved && [...sel.options].some((o) => o.value === saved)) sel.value = saved;
  } catch {
    /* 저장 불가 환경 */
  }
  sel.addEventListener('change', () => {
    show();
    try {
      localStorage.setItem(KEY, sel.value);
    } catch {
      /* 저장 불가 환경 */
    }
  });
  show();
</script>
