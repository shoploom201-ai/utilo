---
// 루트(/) 페이지: 언어 선택. 브라우저 언어가 지원 언어면 자동으로 이동합니다.
import '../styles/global.css';
import { locales, defaultLocale, t } from '../i18n';
import { SITE } from '../site';

const site = Astro.site ?? new URL('https://example.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name}</title>
    <meta name="description" content={t(defaultLocale).tagline} />
    <link rel="canonical" href={new URL('/', site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ locales }}>
      const pick = (navigator.languages || [navigator.language])
        .map((l) => l.toLowerCase().split('-')[0])
        .find((l) => locales.includes(l));
      if (pick) location.replace('/' + pick + '/');
    </script>
  </head>
  <body>
    <main class="wrap">
      <h1>{SITE.name}</h1>
      <ul class="tool-grid">
        {
          locales.map((l) => (
            <li>
              <a class="card" href={`/${l}/`} hreflang={l} lang={l}>
                <strong>{t(l).langName}</strong>
                <span>{t(l).tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
