---
// 루트(/) 페이지: 언어 선택 (x-default). 검색엔진이 각 언어 페이지를 찾도록 자동 이동은 하지 않습니다.
import '../styles/global.css';
import { locales, defaultLocale, t } from '../i18n';
import { SITE } from '../site';

const site = Astro.site ?? new URL('https://example.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name}</title>
    <meta name="description" content={t(defaultLocale).tagline} />
    <link rel="canonical" href={new URL('/', site).href} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* AdSense 사이트 확인: 구글은 루트 주소(/)를 기준으로 확인함 */}
    {SITE.adsense.client && <meta name="google-adsense-account" content={SITE.adsense.client} />}
    {
      SITE.adsense.client && (
        <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.client}`} crossorigin="anonymous" />
      )
    }
  </head>
  <body>
    <main class="wrap">
      <h1>{SITE.name}</h1>
      <ul class="tool-grid">
        {
          locales.map((l) => (
            <li>
              <a class="card" href={`/${l}/`} hreflang={l} lang={l}>
                <strong>{t(l).langName}</strong>
                <span>{t(l).tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
