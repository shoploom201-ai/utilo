---
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, t, type Locale } from '../../i18n';
import { toolsFor, categories, toolPath, samePaths } from '../../tools';
import { SITE } from '../../site';
import { radioTargets, radioPath } from '../../i18n/seo';
import AdSlot from '../../components/AdSlot.astro';
import { Image } from 'astro:assets';
import { postsFor, postPath, blogUi } from '../../lib/blog';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const site = Astro.site ?? new URL('https://example.com');
const latest = (await postsFor(lang)).slice(0, 3);
const bu = blogUi[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(`/${lang}/`, site).href,
    inLanguage: lang,
    description: d.tagline,
  },
];
---

<Base lang={lang} title={d.home.title} description={d.tagline} paths={samePaths('/')} jsonLd={jsonLd} isHome xDefaultPath="/">
  <h1>{d.home.title}</h1>
  <p class="lead">{d.home.intro}</p>
  {
    d.radio && radioTargets(lang).length > 0 && (
      <section>
        <h2>📻 {d.radio.category}</h2>
        <ul class="tool-grid">
          {radioTargets(lang).map(({ target, title }) => (
            <li>
              <a class="card" href={radioPath(lang, target)}>
                <strong>{d.radio!.name.replaceAll('{target}', new Intl.DisplayNames([lang], { type: 'language' }).of(target) ?? target)}</strong>
                <span>{title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <!-- ② 홈 화면 중간 (라디오 묶음 다음) -->
  <AdSlot lang={lang} position="inContent" />
  {
    categories.map((cat) => (
      <section>
        <h2>{d.home.categories[cat]}</h2>
        <ul class="tool-grid">
          {toolsFor(lang)
            .filter((tool) => tool.category === cat)
            .map((tool) => (
              <li>
                <a class="card" href={toolPath(lang, tool.id)}>
                  <strong>{d.tools[tool.id]!.name}</strong>
                  <span>{d.tools[tool.id]!.short}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  {
    latest.length > 0 && (
      <section>
        <h2>📝 {bu.latest}</h2>
        <ul class="post-grid">
          {latest.map((p) => (
            <li>
              <a class="post-card" href={postPath(p)}>
                <Image src={p.data.cover} alt={p.data.coverAlt} widths={[400, 640]} sizes="(max-width: 600px) 100vw, 280px" />
                <div class="post-card__body">
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p><a href={`/${lang}/blog/`}>{bu.all} →</a></p>
      </section>
    )
  }
</Base>
